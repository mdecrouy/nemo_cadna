%PROD_XIOS_HOME      /ccc/scratch/cont005/gen13051/decrouym/xios-2-trunk-ifort
%DEBUG_XIOS_HOME     /ccc/scratch/cont005/gen13051/decrouym/xios-2-trunk-ifort

%NCDF_INC            -I$NETCDFFORTRAN_INCDIR -I$NETCDF_INCDIR
%NCDF_LIB            -L$NETCDFFORTRAN_LIBDIR -lnetcdff -L$NETCDF_LIBDIR -lnetcdf -L$HDF5_LIBDIR -lhdf5_hl -lhdf5 -lz -lcurl

%XIOS_INC            -I%DEBUG_XIOS_HOME/inc
%XIOS_LIB            -L%DEBUG_XIOS_HOME/lib -lxios -lstdc++

%CADNA_PREFIX        /ccc/work/cont005/gen13051/decrouym/cadnac_ifort

%CADNA_INC           -I%CADNA_PREFIX/include
%CADNA_LIB           -L%CADNA_PREFIX/lib -lcadnaMPIFortran -lcadnaMPICdebug -lcadnaFortran -lcadnaCdebug -lstdc++ -lmpi_cxx

%CPP                 cpp -Dkey_single -Dkey_nosignedzero
%FC                  mpif90 -c -cpp
%PROD_FCFLAGS        -i4 -O3 -fp-model strict -axCORE-AVX2 -fno-alias
%DEBUG_FCFLAGS       -i4 -g -O0 -debug all -traceback -fp-model strict -ftrapuv -check all,noarg_temp_created -fpe-all0 -ftz -init=arrays,snan,huge
%FFLAGS              %FCFLAGS
%LD                  mpif90
%LDFLAGS
%FPPFLAGS            -P -traditional
%AR                  ar
%ARFLAGS             rs
%MK                  gmake
%USER_INC            %XIOS_INC %NCDF_INC %CADNA_INC
%USER_LIB            %XIOS_LIB %NCDF_LIB %CADNA_LIB

%CC                  icc
%CFLAGS              -O0

